# This file is a reference template only.
# The actual .desktop file is generated by scripts/install_raspberry_pi_os.sh
# using the real install paths. Do not install this file directly.
[Desktop Entry]
Version=1.0
Type=Application
Name=Boombox
Comment=Boombox audio player
Exec=/opt/boombox/boombox
Icon=/opt/boombox/resources/icon.jpg
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;boombox;
StartupNotify=true
